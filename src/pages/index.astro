---
import Hero from '../components/Hero.astro';
import Grid from '../components/Grid.astro';
import Timeline from '../components/Timeline.astro';
import TimelinePreview from '../components/TimelinePreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../config/index';
import ryan from '../config/ryan';
import { parseProject } from '../utils/parseProject';

const sort = (arr: any[]) =>
	arr.map(parseProject).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const ryanProjects = sort(ryan.projects);
---

<BaseLayout>
	<div class="stack gap-20 lg:gap-48">

		<!-- Hero -->
		<Hero
			tagline="full-stack engineer / indie game developer"
			titleCfgKey="hero.title"
			taglineCfgKey="hero.tagline"
		/>

		<!-- Selected Work -->
		<main class="wrapper rek-timeline-section" id="projects">
			<div class="rek-section-header">
				<h2 class="rek-section-title">Selected Work</h2>
				<a href={`${import.meta.env.BASE_URL}work/`} class="rek-section-link">
					view all →
				</a>
			</div>

			<ul class="rek-timeline">
				{ryanProjects.slice(0, 8).map((project, i) => (
					<TimelinePreview project={project} index={i} />
				))}
			</ul>
		</main>

	</div>
</BaseLayout>
