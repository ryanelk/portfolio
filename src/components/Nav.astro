---
import MusicStatus from './MusicStatus.astro';
import config from '../config/index';

const textLinks = [
	{ label: 'Projects', href: `${import.meta.env.BASE_URL}work/` },
];

const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== `${import.meta.env.BASE_URL}` && pathname.startsWith(href));
};
---

<nav class="rek-nav">
	<!-- Logo mark -->
	<a href={`${import.meta.env.BASE_URL}`} class="rek-nav-logo" data-cfg="name">REK</a>

	<!-- Right side: pill + music widget -->
	<div class="rek-nav-right">
		<div class="rek-nav-pill">
			{textLinks.map(({ label, href }) => (
				<a
					aria-current={isCurrentPage(href) ? 'page' : null}
					class="rek-nav-link"
					href={href}
				>
					{label.toLowerCase()}
				</a>
			))}

			<a
				aria-current={isCurrentPage(`${import.meta.env.BASE_URL}about/`) ? 'page' : null}
				class="rek-nav-link"
				href={`${import.meta.env.BASE_URL}about/`}
			>
				about
			</a>
		</div>

		<MusicStatus client:load />
	</div>
</nav>
