---
// Blob-based animated background. Replaces the wave background.
// blob-music reacts to --music-color-1 CSS var set by MusicStatus.
---

<div class="blob-stage" aria-hidden="true">
	<div class="blob-item blob-purple"></div>
	<div class="blob-item blob-music"></div>
	<div class="blob-item blob-teal"></div>
	<div class="blob-noise"></div>
</div>
