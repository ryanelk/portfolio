---
import config from '../config/index';

interface Props {
	tagline?: string;
	titleCfgKey?: string;
	taglineCfgKey?: string;
}
const { tagline, titleCfgKey, taglineCfgKey } = Astro.props;
---

<section class="rek-hero">
	<span class="rek-hero-watermark" aria-hidden="true">{config.watermark}</span>

	<div class="rek-hero-content">
		<h1 class="rek-hero-heading" data-cfg={titleCfgKey}>
			Development<br />with intention.
		</h1>
		{tagline && (
			<p class="rek-hero-sub" data-cfg={taglineCfgKey}>{tagline}</p>
		)}
		<slot />
	</div>

</section>
