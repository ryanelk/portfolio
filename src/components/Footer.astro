---
import Icon from './Icon.astro';
import config from '../config/index';

const currentYear = new Date().getFullYear();
---

<footer class="rek-footer">
	<div class="rek-footer-inner">
		<span class="rek-footer-brand">{config.watermark}</span>
		<ul class="rek-footer-socials">
			{config.socials.map(({ href, icon, label }) => (
				<li>
					<a href={href} aria-label={label}>
						<Icon icon={icon} size="1.6em" />
					</a>
				</li>
			))}
		</ul>
		<span class="rek-footer-copy">© {currentYear}</span>
	</div>
</footer>
