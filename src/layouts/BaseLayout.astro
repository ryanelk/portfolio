---
import Footer from '../components/Footer.astro';
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import WaveBackground from '../components/WaveBackground.astro';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;

import config from '../config';

const toVars = (map: Record<string, string>) =>
	Object.entries(map).map(([k, v]) => `--${k}: ${v};`).join(' ');

const themeStyle = `
	:root { ${toVars(config.theme.light)} }
	:root.theme-dark { ${toVars(config.theme.dark)} }
`;
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
		<Fragment set:html={`<style>${themeStyle}</style>`} />
	</head>
	<body>
		<!-- Animated blob background -->
		<WaveBackground />

		<div class="layout-stack">
			<Nav />
			<slot />
			<Footer />
		</div>

		<script>
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			.layout-stack {
				position: relative;
				z-index: 1;
				min-height: 100%;
				isolation: isolate;
				background: transparent;
			}
		</style>
	</body>
</html>
